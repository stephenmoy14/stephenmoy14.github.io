---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

const profile = (await getEntry('profile', 'me'))!.data;

// Newest first; current roles (no end date) float to the top.
const items = (await getCollection('experience')).sort(
  (a, b) =>
    (b.data.end ?? '9999-12').localeCompare(a.data.end ?? '9999-12') ||
    b.data.start.localeCompare(a.data.start),
);
---

<BaseLayout title="Experience">
  <h1>Experience</h1>
  {
    profile.resume && (
      <p class="intro">
        <a class="button secondary" href={profile.resume}>Download resume (PDF)</a>
      </p>
    )
  }
  <div class="timeline">
    {items.map((item) => <ExperienceItem item={item} />)}
  </div>

  {
    profile.skills.length > 0 && (
      <section>
        <h2>Skills</h2>
        <ul class="chips">
          {profile.skills.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    margin-bottom: 2.5rem;
  }
  h1 {
    margin-bottom: 2rem;
  }
  section {
    margin-top: 3rem;
  }
</style>
