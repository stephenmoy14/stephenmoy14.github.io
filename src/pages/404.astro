---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="actions">
      <a class="button primary" href="/">Go home</a>
      <a class="button secondary" href="/projects/">See projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 36rem;
    padding-block: 2rem;
  }
  .code {
    margin: 0;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
