---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = (await getEntry('profile', 'me'))!.data;
---

<BaseLayout title="Contact" description={`How to reach ${profile.name}: email, LinkedIn, and GitHub.`}>
  <h1>Contact</h1>
  <p>The best ways to reach me:</p>
  <ul>
    {
      profile.email && (
        <li>
          Email: <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
      )
    }
    {
      profile.links.map((l) => (
        <li>
          <a href={l.url} rel="noopener">{l.label}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
