---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = (await getEntry('profile', 'me'))!.data;
// "(224) 381-5080" -> "+12243815080" for the tap-to-call link
const tel = profile.phone ? `+1${profile.phone.replace(/\D/g, '')}` : undefined;
---

<BaseLayout title="Contact">
  <h1>Contact</h1>
  <p>The best ways to reach me:</p>
  <ul>
    {
      profile.email && (
        <li>
          Email: <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
      )
    }
    {
      profile.phone && (
        <li>
          Phone: <a href={`tel:${tel}`}>{profile.phone}</a>
        </li>
      )
    }
    {
      profile.links.map((l) => (
        <li>
          <a href={l.url} rel="noopener">{l.label}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
