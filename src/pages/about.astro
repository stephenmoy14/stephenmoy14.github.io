---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import PhotoGrid from '../components/PhotoGrid.astro';

const profile = (await getEntry('profile', 'me'))!.data;
const photos = await getCollection('photos');
const hobbies = (await getCollection('hobbies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  hobbies.map(async (h) => ({
    h,
    photos: photos.filter((p) => p.data.hobby?.id === h.id),
    ...(await render(h)),
  })),
);
---

<BaseLayout title="About">
  <h1>About</h1>
  <p>{profile.bio}</p>

  {
    rendered.length > 0 && (
      <section>
        <h2>Outside of work</h2>
        {rendered.map(({ h, photos, Content }) => (
          <article>
            <h3>
              {h.data.title}
              <Placeholder show={h.data.placeholder} />
            </h3>
            <p>{h.data.summary}</p>
            <Content />
            {photos.length > 0 && <PhotoGrid photos={photos} />}
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  article + article {
    margin-top: 2rem;
  }
</style>
