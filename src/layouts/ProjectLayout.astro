---
// Wraps a project's Markdown write-up (use ## headings for its sections).
// Links (repo, demo) come from the frontmatter and are shown at the bottom.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { title, summary, status, tech, repo, demo, cover, coverAlt, placeholder } =
  Astro.props.project.data;
const statusLabel = { 'in-progress': 'In progress', complete: 'Complete', archived: 'Archived' }[status];
---

<BaseLayout title={title} description={summary}>
  <article>
    <p><a href="/projects/">← All projects</a></p>
    <h1>
      {title}
      <Placeholder show={placeholder} />
    </h1>
    <p class="summary">{summary}</p>
    <p class="meta">
      {statusLabel}
      {tech.length > 0 && <span> · {tech.join(', ')}</span>}
    </p>

    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} />}

    <div class="body">
      <slot />
    </div>

    {
      (repo || demo) && (
        <section>
          <h2>Links</h2>
          <ul>
            {repo && (
              <li>
                <a href={repo} rel="noopener">Source code</a>
              </li>
            )}
            {demo && (
              <li>
                <a href={demo} rel="noopener">Live app</a>
              </li>
            )}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .summary {
    font-size: 1.15rem;
  }
  .meta {
    color: var(--muted);
  }
  /* Phone screenshots: keep them phone-sized and centered. */
  .cover {
    display: block;
    max-width: min(100%, 360px);
    height: auto;
    margin: 1.5rem auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
</style>
