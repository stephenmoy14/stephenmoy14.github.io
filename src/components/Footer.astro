---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'me');
const year = new Date().getFullYear();
---

<footer>
  <p>© {year} {profile?.data.name}</p>
  <ul>
    {
      profile?.data.email && (
        <li>
          <a href={`mailto:${profile.data.email}`}>Email</a>
        </li>
      )
    }
    {
      profile?.data.links.map((l) => (
        <li>
          <a href={l.url} rel="noopener">{l.label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
    padding: 1.75rem 0 2.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
</style>
