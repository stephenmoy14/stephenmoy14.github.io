---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';

interface Props {
  item: CollectionEntry<'experience'>;
}
const { role, org, location, start, end, bullets, placeholder } = Astro.props.item.data;

const fmt = (ym: string) =>
  new Date(`${ym}-01T00:00:00`).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<article>
  <div class="head">
    <h3>
      {role}
      <Placeholder show={placeholder} />
    </h3>
    <p class="dates">{fmt(start)} – {end ? fmt(end) : 'Present'}</p>
  </div>
  <p class="org">
    {org}
    {location && <span class="muted"> · {location}</span>}
  </p>
  {
    bullets.length > 0 && (
      <ul>
        {bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  /* Simple timeline: a line down the left with a navy dot per role. */
  article {
    position: relative;
    padding: 0 0 2rem 1.5rem;
    border-left: 2px solid var(--border);
  }
  article:last-of-type {
    padding-bottom: 0.5rem;
  }
  article::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
  }
  h3 {
    margin: 0;
  }
  .dates {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .org {
    margin: 0.15rem 0 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }
  ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text);
  }
  li + li {
    margin-top: 0.4rem;
  }
  li::marker {
    color: var(--muted);
  }
</style>
