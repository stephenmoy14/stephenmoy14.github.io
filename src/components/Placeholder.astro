---
// Small visible tag for anything marked `placeholder: true` in its data file.
interface Props {
  show?: boolean;
}
const { show = false } = Astro.props;
---

{show && <span class="placeholder">PLACEHOLDER</span>}

<style>
  .placeholder {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    background: #fde68a;
    color: #713f12;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    vertical-align: middle;
  }
</style>
